{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Project Graph PG1.1",
  "version": "1.1.0",
  "identifier": "eingustaf07.project-graph-custom",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "beforeBundleCommand": "node ./scripts/collect-cef-linux.js",
    "frontendDist": "../dist",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Graph PG1.1",
        "url": "/index.html",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "rpm", "dmg", "app"],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "longDescription": "A simple tool to create topology diagrams.",
    "shortDescription": "Diagram creator",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "TradChinese", "English", "Indonesian"],
        "sidebarImage": "nsis/left.bmp",
        "headerImage": "nsis/project-graph-install.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib/project-graph/": "cef-linux-runtime/"
        }
      },
      "deb": {
        "files": {
          "/usr/lib/project-graph/": "cef-linux-runtime/"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/project-graph/": "cef-linux-runtime/"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["prg-custom"]
      }
    },
    "cli": {
      "description": "A simple tool to create topology diagrams.",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "output",
          "short": "o",
          "takesValue": true,
          "multiple": false
        },
        {
          "name": "size",
          "short": "s",
          "takesValue": true,
          "multiple": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQzM3OTE1QjgwRTRCNzEKUldSeFN3NjRGWG5Ec2hVb05sWGZhVmpJdEVCR2cwNmM4UXlISEN5eHJBeFlCQkF3VjV6Z0tEY08K",
      "endpoints": ["https://release.project-graph.top/update/{{target}}/{{arch}}/{{current_version}}"],
      "windows": {
        "installMode": "passive"
      }
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": ".*"
    }
  }
}
